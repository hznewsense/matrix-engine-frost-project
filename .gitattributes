# 统一按 LF 存库，构建脚本在 Windows 下保持 CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# PCK 是导出的游戏内容包, 约 177 MB, 超过 GitHub 单文件 100 MB 限制, 走 LFS 入库.
MEFrostJava/app/src/main/assets/frost.pck filter=lfs diff=lfs merge=lfs -text

# 引擎 fat AAR 会随引擎版本迭代整体替换, 放 LFS 避免每个版本在历史里留一份完整副本.
MEFrostJava/app/libs/*.aar filter=lfs diff=lfs merge=lfs -text
